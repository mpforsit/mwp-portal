# Payload-API für Build-Time-Fetch
PAYLOAD_API_URL=http://localhost:3000/api
# API-Key des Service-Users (Seed: build@example.com). Der Build braucht
# ihn, um zugriffsgeschützte Relationen (Autor-Name) zu populieren.
PAYLOAD_API_TOKEN=
# Draft-Preview (nur Staging): true = Build rendert auch Entwürfe
# (siehe docs/adr/0001-draft-preview-als-staging-build.md)
PAYLOAD_DRAFT_PREVIEW=false
# Kanonische Basis-URL (Staging/Prod unterschiedlich); fließt in
# JSON-LD und Astro.site
SITE_URL=https://portal.example
# Podigee-Podcast-Basis-URL für den Player-Embed (Schritt 1.6)
PODIGEE_BASE_URL=https://PLATZHALTER.podigee.io
# Öffentliche Basis-URL der API (Newsletter, Affiliate-Redirects,
# Praxisfinder); PUBLIC_ = im Client sichtbar
PUBLIC_API_URL=http://localhost:3001
# Consent & Tracking (Schritt 1.8) — leer = Dienst deaktiviert
# sGTM-Loader-URL (Stape), inkl. Container-ID
PUBLIC_SGTM_URL=https://sgtm.my-well.com/gtm.js?id=GTM-XXXXXXX
# Self-hosted Plausible (cookielos, immer aktiv)
PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.my-well.com/js/script.js
PUBLIC_PLAUSIBLE_DOMAIN=my-well.com
# Shop-Hosts für Outbound-Klick-Events (kommagetrennt)
PUBLIC_SHOP_HOSTS=shop.metalytic.de
# IndexNow-Key (Schritt 1.9): erzeugt /<key>.txt im Build; gleicher
# Wert wie INDEXNOW_KEY im CMS
INDEXNOW_KEY=
# Basis-URL der API für Build-Time-Fetches (Vergleichs-Engine)
API_URL=http://localhost:3001
