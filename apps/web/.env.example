# Payload-API für Build-Time-Fetch
PAYLOAD_API_URL=http://localhost:3000/api
# API-Key des Service-Users (Seed: build@example.com). Der Build braucht
# ihn, um zugriffsgeschützte Relationen (Autor-Name) zu populieren.
PAYLOAD_API_TOKEN=
# Draft-Preview (nur Staging): true = Build rendert auch Entwürfe
# (siehe docs/adr/0001-draft-preview-als-staging-build.md)
PAYLOAD_DRAFT_PREVIEW=false
# Kanonische Basis-URL (Staging/Prod unterschiedlich); fließt in
# JSON-LD und Astro.site
SITE_URL=https://portal.example
# Podigee-Podcast-Basis-URL für den Player-Embed (Schritt 1.6)
PODIGEE_BASE_URL=https://PLATZHALTER.podigee.io
# Basis-URL der API (Newsletter-Anmeldung); PUBLIC_ = im Client sichtbar
PUBLIC_NEWSLETTER_API_URL=http://localhost:3001
