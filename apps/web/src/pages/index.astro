---
const zones = [
  { href: '/wissen/', label: 'Wissen' },
  { href: '/vergleich/', label: 'Vergleich' },
  { href: '/messen/', label: 'Messen' },
]
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portal — Platzhalter</title>
  </head>
  <body>
    <h1>Portal-Grundgerüst</h1>
    <p>Platzhalter-Startseite aus Schritt 0.1. Layouts, Designsystem und Zonen folgen in Schritt 1.2.</p>
    <nav>
      <ul>
        {zones.map((zone) => (
          <li><a href={zone.href}>{zone.label}</a></li>
        ))}
      </ul>
    </nav>
  </body>
</html>
