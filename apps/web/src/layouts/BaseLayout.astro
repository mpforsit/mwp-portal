---
import ConsentManager from '../components/ConsentManager.astro'
import JsonLd from '../components/JsonLd.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import type { JsonLdNode } from '../lib/jsonld'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  activeZone?: 'wissen' | 'vergleich' | 'messen'
  jsonLdNodes?: JsonLdNode[]
}

const { title, description, activeZone, jsonLdNodes } = Astro.props
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <JsonLd nodes={jsonLdNodes} />
  </head>
  <body>
    <SiteHeader activeZone={activeZone} />
    <main class="site-main">
      <div class="page">
        <slot />
      </div>
    </main>
    <SiteFooter />
    <ConsentManager />
  </body>
</html>
