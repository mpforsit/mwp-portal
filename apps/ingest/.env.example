PORT=3002
# Gemeinsame Postgres-Instanz; Ingest nutzt das Schema "ingest" und
# liest/promotet nach "vergleich".
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal
# Basic-Auth für die Ingest-Admin-Oberfläche (eigener Zugang)
INGEST_ADMIN_USER=
INGEST_ADMIN_PASSWORD=
# Anthropic-API für die LLM-Faktenextraktion (Schritt 7); leer = die
# Extraktion ist deaktiviert. Nie ins Repo — nur als Env/Secret.
ANTHROPIC_API_KEY=
