DATABASE_URL=postgresql://portal:portal@localhost:5432/portal
# mind. 32 zufällige Zeichen, z. B. `openssl rand -hex 32`
PAYLOAD_SECRET=
# Coolify-Deploy-Hook: wird bei Publish/Update publizierter Artikel
# aufgerufen (Frontend-Rebuild). Leer = kein Webhook.
REBUILD_WEBHOOK_URL=
# IndexNow (Bing) — gleicher Key wie im Web-Build (INDEXNOW_KEY dort
# erzeugt /<key>.txt); leer = kein Ping. Dazu SITE_URL für die
# Artikel-URLs.
INDEXNOW_KEY=
SITE_URL=https://my-well.com
