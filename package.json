{
  "name": "mwp-portal",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "dev:db": "docker compose up -d db"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "typescript-eslint": "^8.63.0"
  }
}
